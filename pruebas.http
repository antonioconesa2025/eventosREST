###############################################################################
# ARCHIVO DE PRUEBAS PARA REST CLIENT (Visual Studio Code)
# API RESTful - Gestión de Eventos, Recintos y Entradas
###############################################################################

@baseUrl = http://localhost:3000

# ID ficticio para pruebas de casos no encontrados (Error 404)
@idInexistente = 60d5ec49f1b2c82d88c8e1a0


# =============================================================================
# 1. CREACIÓN DE RECINTOS (POST /recintos) - 5 EJEMPLOS
# =============================================================================

### 1.1 Crear Recinto 1: WiZink Center
# @name crearRecinto1
POST {{baseUrl}}/recintos HTTP/1.1
Content-Type: application/json

{
  "nombre": "WiZink Center",
  "direccion": "Avenida Felipe II, s/n",
  "localidad": "Madrid",
  "aforoMaximo": 17453
}

### 1.2 Crear Recinto 2: Palau Sant Jordi
# @name crearRecinto2
POST {{baseUrl}}/recintos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Palau Sant Jordi",
  "direccion": "Passeig Olímpic, 5-7",
  "localidad": "Barcelona",
  "aforoMaximo": 18000
}

### 1.3 Crear Recinto 3: Estadio Santiago Bernabéu
# @name crearRecinto3
POST {{baseUrl}}/recintos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Estadio Santiago Bernabéu",
  "direccion": "Avenida de Concha Espina, 1",
  "localidad": "Madrid",
  "aforoMaximo": 81044
}

### 1.4 Crear Recinto 4: Auditorio Rocío Jurado
# @name crearRecinto4
POST {{baseUrl}}/recintos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Auditorio Rocío Jurado",
  "direccion": "Camino de los Descubrimientos, s/n",
  "localidad": "Sevilla",
  "aforoMaximo": 8000
}

### 1.5 Crear Recinto 5: Teatro Circo Price (para pruebas de borrado)
# @name crearRecinto5
POST {{baseUrl}}/recintos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Teatro Circo Price",
  "direccion": "Ronda de Atocha, 35",
  "localidad": "Madrid",
  "aforoMaximo": 2000
}


# =============================================================================
# 2. CONSULTAS DE RECINTOS (GET /recintos)
# =============================================================================

### 2.1 Obtener todos los recintos (Ejemplo 1)
GET {{baseUrl}}/recintos HTTP/1.1

### 2.2 Obtener todos los recintos con cabecera Accept (Ejemplo 2)
GET {{baseUrl}}/recintos HTTP/1.1
Accept: application/json

### 2.3 Obtener un recinto por su ID existente (Ejemplo 1)
GET {{baseUrl}}/recintos/{{crearRecinto1.response.body.resultado._id}} HTTP/1.1

### 2.4 Obtener un recinto por ID inexistente - Error 404 (Ejemplo 2)
GET {{baseUrl}}/recintos/{{idInexistente}} HTTP/1.1

### 2.5 Obtener recintos por localidad existente: Madrid (Ejemplo 1)
GET {{baseUrl}}/recintos/localidad/Madrid HTTP/1.1

### 2.6 Obtener recintos por localidad sin recintos: Valencia - Error 404 (Ejemplo 2)
GET {{baseUrl}}/recintos/localidad/Valencia HTTP/1.1


# =============================================================================
# 3. CREACIÓN DE EVENTOS (POST /eventos) - 5 EJEMPLOS
# =============================================================================

### 3.1 Crear Evento 1: Concierto Rock Fest (WiZink Center)
# @name crearEvento1
POST {{baseUrl}}/eventos HTTP/1.1
Content-Type: application/json

{
  "nombre": "Concierto Rock Fest 2027",
  "fecha": "2027-06-15T21:00:00.000Z",
  "recinto": "{{crearRecinto1.response.body.resultado._id}}",
  "entradas": [
    {
      "tipo": "General",
      "precio": 45.0,
      "disponibles": 500
    },
    {
      "tipo": "VIP",
      "precio": 120.0,
      "disponibles": 100
    },
    {
      "tipo": "Pista",
      "precio": 65.0,
      "disponibles": 300
    }
  ]
}

